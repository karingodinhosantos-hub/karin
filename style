:root {
    --cor-primaria: #243bbbe0;
    --cor-secundaria: #1b6fc9;
    --cor-fundo: #ffffff;
    --cor-texto: #151428;
    --cor-contraste: #f3eef7;
    --cor-botao: #f9f9f9;

    --fonte-texto: 'Segoe UI', sans-serif;
}

*{
    transition: background-color 0.8s ease;
}

.tema-escuro{
    --cor-primaria: #709be9e0;
    --cor-secundaria: #8db9e7;
    --cor-fundo: #030430;
    --cor-texto: #f1f1f5;
    --cor-contraste: #020329;
    --cor-botao: #030303;
}

.tema-escuro a {
    color: var(--cor-secundaria);
}

.tema-escuro p {
    color: var(--cor-texto);
}

.tema-escuro header p {
    color: var(--cor-contraste);
}

.tema-escuro .btn-tema-escuro{
    beckground-color: var(--cor-secundaria);
}

body {
    max-width: 100vw;
    font-family: var(--fonte-texto);
    
}

header{
    background-color: var (var(--cor-primaria));
    color: var(--cor-fundo);
    text-align: center;
    margin: 0 auto;
    padding: 16px;
}

main {
    background-color: var(--cor-fundo);
    color:var(--cor-primaria);
    margin: 0 auto;
    padding: 16px;

    display: flex;
    flex-wrap: wrap;
}

article{
    display: flex;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);

    margin: 16px;
    gap: 16px;
    padding: 16px;
    
    flex: 1 1 25%;

    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
} 

img{
    width: 80px;
    height: 80px;
}

.artigo-autor{
    font-weight: bold;
}

.btn-tema-escuro{
    position: fixed;
    bottom: 16px;
    right: 16px;
    font-size: 32px;
    padding: 12px;
    background-color: var(--cor-primaria);
    border-radius: 50%;
}
