.tema-escuro{
    --cor-primaria: #709be9e0;
    --cor-secundaria: #8db9e7;
    --cor-fundo: #030430;
    --cor-texto: #f1f1f5;
    --cor-contraste: #020329;
    --cor-botao: #030303;
}

.tema-escuro a {
    color: var(--cor-secundaria);
}

.tema-escuro p {
    color: var(--cor-texto);

}

.tema-escuro header p {
    color: var(--cor-contraste);
}

body {
    max-width: 100vw;
    font-family: 'Segoe UI', sans-serif;
    
}

header{
    background-color: var (var(--cor-primaria));
    color: var(--cor-fundo);
    text-align: center;
    margin: 0 auto;
    padding: 16px;
}

main {
    background-color: var(--cor-fundo);
    color:var(--cor-primaria);
    margin: 0 auto;
    padding: 16px;

    display: flex;
    flex-wrap: wrap;
}

article{
    display: flex;

    border: 1px solid var(--cor-primaria);  

    margin: 16px;
    gap: 16px;
    padding: 16px;
    
    flex: 1 1 25%;

    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
} 

img{
    width: 80px;
    height: 80px;
}

.artigo-autor{
    font-weight: bold;
}
